{
  "manifest_version": 3,
  "name": "ExLeo Cookie Exporter",
  "version": "1.0.0",
  "description": "Ambil full cookie Leonardo (app.leonardo.ai) untuk LeoAPI dengan satu klik.",
  "action": {
    "default_title": "ExLeo Cookie Exporter",
    "default_popup": "popup.html"
  },
  "permissions": [
    "cookies",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://app.leonardo.ai/*",
    "https://*.leonardo.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.leonardo.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
